# ---------------------------------------------------------------------------------------------
# Template for the .env file on the LIVE server.   See DEPLOYMENT.md, step 4.
#
#   1. On the server, copy this file to a file named exactly  .env
#   2. Fill in every line marked  <<< CHANGE ME
#   3. NEVER commit the real .env to Git and never send it by email or chat: it contains passwords.
#
# This file itself contains no secrets, so it is safe to keep in Git.
# ---------------------------------------------------------------------------------------------

APP_NAME="Restaurants Directory Listing"
APP_ENV=production
# Create the key on the server with:  php artisan key:generate --force   (leave empty here)
APP_KEY=
APP_DEBUG=false
# Your real address, with https  <<< CHANGE ME
APP_URL=https://RestaurantsDirectory.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
BCRYPT_ROUNDS=12

# Errors are written to storage/logs, one file per day, kept for 14 days. "warning" keeps the files small.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (MySQL). Create a database and a user for it first (DEPLOYMENT.md, step 3) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_directory
DB_USERNAME=<<< CHANGE ME
DB_PASSWORD=<<< CHANGE ME

# --- Sessions and cache: stored in the database (the tables are created by the migrations) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Cookies only travel over https. Needs https to be working on your domain.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Proxy ---
# Leave EMPTY if visitors reach your server directly.
# If your host or Cloudflare sits in front of your server, set it, or all visitors look like one person to the
# spam limits. See DEPLOYMENT.md, "Behind a proxy or Cloudflare".
TRUSTED_PROXIES=

# --- Email ---
# The site does not send any email (contact messages and suggestions are read in /admin).
MAIL_MAILER=log

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
